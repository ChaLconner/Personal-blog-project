{
  "name": "my-side-project",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack blog application with React frontend and Node.js backend",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    
    "start:client": "cd client && npm start",
    "start:server": "cd server && npm start",
    "start": "concurrently \"npm run start:client\" \"npm run start:server\"",
    
    "build:client": "node scripts/runWorkspaceTasks.js build:client",
    "build:server": "node scripts/runWorkspaceTasks.js build:server",
    "build": "node scripts/runWorkspaceTasks.js build",
    "lint": "node scripts/runWorkspaceTasks.js lint",
    "check": "node scripts/runWorkspaceTasks.js check",
    
    "prod:client": "cd client && npm run preview",
    "prod:server": "cd server && NODE_ENV=production npm start",
    "prod": "npm run build && concurrently \"npm run prod:server\" \"npm run prod:client\"",
    
    "install:client": "cd client && npm install",
    "install:server": "cd server && npm install",
    "install:all": "npm run install:client && npm run install:server",
    
    "clean": "node -e \"const fs=require('fs'); ['client/dist','client/node_modules','server/node_modules'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "clean:logs": "node -e \"const fs=require('fs'),path=require('path'); const walk=d=>fs.readdirSync(d,{withFileTypes:true}).forEach(f=>{const p=path.join(d,f.name); if(f.isDirectory()&&f.name!=='node_modules')walk(p); else if(f.name.endsWith('.log'))fs.unlinkSync(p);}); walk('.');\"",
    
    "test:client": "node scripts/runWorkspaceTasks.js test:client",
    "test:server": "node scripts/runWorkspaceTasks.js test:server",
    "test": "node scripts/runWorkspaceTasks.js test"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0 <12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChaLconner/Personal-blog-project.git"
  },
  "keywords": [
    "blog",
    "react",
    "nodejs",
    "express",
    "supabase",
    "fullstack"
  ],
  "author": "ChaLconner",
  "license": "MIT"
}
